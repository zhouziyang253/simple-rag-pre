{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}",
                "HTTP_PROXY": "http://127.0.0.1:7898",
                "HTTPS_PROXY": "http://127.0.0.1:7898",
                "http_proxy": "http://127.0.0.1:7898",
                "https_proxy": "http://127.0.0.1:7898",
                "ALL_PROXY": "http://127.0.0.1:7898",
                "all_proxy": "http://127.0.0.1:7898",
                "NO_PROXY": "localhost,127.0.0.1",
                "no_proxy": "localhost,127.0.0.1"
            }
        }
    ]
}